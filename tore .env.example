[1mdiff --git a/.env.example b/.env.example[m
[1mindex 896ef83..e69de29 100644[m
[1m--- a/.env.example[m
[1m+++ b/.env.example[m
[36m@@ -1,43 +0,0 @@[m
[31m-# =========================================================[m
[31m-# DATABASE — NEON POSTGRESQL[m
[31m-# Neon Dashboard > Connect > Connection string[m
[31m-# =========================================================[m
[31m-DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"[m
[31m-[m
[31m-# =========================================================[m
[31m-# AUTH — BETTER AUTH[m
[31m-# Generate a long random secret for every environment.[m
[31m-# Local URL must match the address used by `npm run dev`.[m
[31m-# =========================================================[m
[31m-BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"[m
[31m-BETTER_AUTH_URL="http://localhost:3000"[m
[31m-[m
[31m-# Keep false while developing if you do not have an email provider yet.[m
[31m-# When true, new email/password accounts must verify their email before login.[m
[31m-AUTH_REQUIRE_EMAIL_VERIFICATION="false"[m
[31m-[m
[31m-# =========================================================[m
[31m-# OAUTH — OPTIONAL[m
[31m-# Better Auth callback URLs in local development:[m
[31m-# Google:  http://localhost:3000/api/auth/callback/google[m
[31m-# Discord: http://localhost:3000/api/auth/callback/discord[m
[31m-# =========================================================[m
[31m-GOOGLE_CLIENT_ID=""[m
[31m-GOOGLE_CLIENT_SECRET=""[m
[31m-DISCORD_CLIENT_ID=""[m
[31m-DISCORD_CLIENT_SECRET=""[m
[31m-[m
[31m-# =========================================================[m
[31m-# TRANSACTIONAL EMAIL — OPTIONAL IN DEVELOPMENT[m
[31m-# Password-reset / verification links are logged to the dev terminal when[m
[31m-# these are empty. Configure them before enabling email verification in prod.[m
[31m-# =========================================================[m
[31m-RESEND_API_KEY=""[m
[31m-AUTH_EMAIL_FROM="TFLives <no-reply@tflives.com>"[m
[31m-[m
[31m-# =========================================================[m
[31m-# TFLIVES DISCORD SERVER INTEGRATION — OPTIONAL[m
[31m-# These are for community/server data, not Discord OAuth login.[m
[31m-# =========================================================[m
[31m-DISCORD_SERVER_ID=""[m
[31m-DISCORD_BOT_TOKEN=""[m

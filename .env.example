# =========================================================
# DATABASE — NEON POSTGRESQL
# Neon Dashboard > Connect > Connection string
# =========================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# =========================================================
# AUTH — BETTER AUTH
# Generate a long random secret for every environment.
# Local URL must match the address used by `npm run dev`.
# =========================================================
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Keep false while developing if you do not have an email provider yet.
# Production should set this to true. New email/password accounts can browse
# public pages, but must verify before sensitive account access/sign-in.
AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# =========================================================
# OAUTH — OPTIONAL
# Better Auth callback URLs in local development:
# Google:  http://localhost:3000/api/auth/callback/google
# Discord: http://localhost:3000/api/auth/callback/discord
# =========================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# =========================================================
# TRANSACTIONAL EMAIL — OPTIONAL IN DEVELOPMENT
# Password-reset / verification links are logged to the dev terminal when
# these are empty. Configure them before enabling email verification in prod.
# =========================================================
RESEND_API_KEY=""
AUTH_EMAIL_FROM="TFLives <no-reply@tflives.com>"

# =========================================================
# TFLIVES DISCORD SERVER INTEGRATION — OPTIONAL
# These are for community/server data, not Discord OAuth login.
# =========================================================
DISCORD_SERVER_ID=""
DISCORD_BOT_TOKEN=""

# Postgres real de Supabase (Project Settings > Database > Connection string > URI)
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

NEXTAUTH_SECRET="dev-only-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Supabase (Project Settings > API)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL="https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Opcionales — completar si vas a probar login con Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Opcionales — completar si vas a probar la integración de Discord
DISCORD_SERVER_ID=""
DISCORD_BOT_TOKEN=""
